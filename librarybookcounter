
class LibraryBookCounter {
    String title;
    String author;
    double price;

    static int bookCount = 0;

    LibraryBookCounter(String title, String author, double price) {
        this.title = title;
        this.author = author;
        this.price = price;
        bookCount++;
    }

    void display() {
        System.out.println("Title: " + title);
        System.out.println("Author: " + author);
        System.out.println("Price: Rs. " + price);
    }

    static void displayCount() {
        System.out.println("Total Books: " + bookCount);
    }
}

class Main {
    public static void main(String[] args) {
        LibraryBookCounter b1 = new LibraryBookCounter("Java Programming", "James Gosling", 450);
        LibraryBookCounter b2 = new LibraryBookCounter("Python Basics", "Guido van Rossum", 350);
        LibraryBookCounter b3 = new LibraryBookCounter("C Programming", "Dennis Ritchie", 300);

        b1.display();
        System.out.println();

        b2.display();
        System.out.println();

        b3.display();
        System.out.println();

        LibraryBookCounter.displayCount();
    }
}

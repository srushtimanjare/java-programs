
class University {

    String universityName;

    University(String universityName) {
        this.universityName = universityName;
    }

    static class Department {

        String departmentName;

        Department(String departmentName) {
            this.departmentName = departmentName;
        }

        void displayDepartment() {
            System.out.println("Department: " + departmentName);
        }
    }

    class Faculty {

        String facultyName;
        String designation;

        Faculty(String facultyName, String designation) {
            this.facultyName = facultyName;
            this.designation = designation;
        }

        void displayFaculty() {
            System.out.println("Faculty Name: " + facultyName);
            System.out.println("Designation: " + designation);
            System.out.println("University: " + universityName);
        }
    }

    void displayUniversity() {
        System.out.println("University Name: " + universityName);
    }

    public static void main(String[] args) {

        University u = new University("ABC University");

        University.Department d =
                new University.Department("Computer Science");

        University.Faculty f =
                u.new Faculty("Rahul", "Professor");

        u.displayUniversity();

        d.displayDepartment();

        f.displayFaculty();
    }
}
